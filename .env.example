# Copy to .env in the repository root. The backend reads it automatically.
APP_ENV=development
API_PORT=3001
# Relative to the backend working directory when using `cd backend && cargo run`.
DATABASE_PATH=workspace.db
# Replace this development placeholder; never commit your actual .env.
JWT_SECRET=replace-with-a-long-random-local-signing-secret
# Only VITE_* variables are exposed to the browser. Never prefix a secret with VITE_.
VITE_API_URL=/api
